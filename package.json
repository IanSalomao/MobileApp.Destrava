{
  "name": "destrava",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @destrava/mobile",
    "lint": "npm run lint -w @destrava/mobile",
    "typecheck": "npm run typecheck -w @destrava/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts && prettier --write apps/mobile/src/lib/database.types.ts",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.120.0"
  }
}
