{
  "name": "destrava",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @destrava/mobile",
    "lint": "npm run lint -w @destrava/mobile",
    "typecheck": "npm run typecheck -w @destrava/mobile",
    "test": "npm run test -w @destrava/mobile",
    "test:db": "supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts && prettier --write apps/mobile/src/lib/database.types.ts",
    "db:push": "supabase db push",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0"
  },
  "lint-staged": {
    "apps/mobile/**/*.{ts,tsx}": "npm run lint -w @destrava/mobile --"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
