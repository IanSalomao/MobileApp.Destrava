# Copie para .env e preencha. Os valores locais aparecem em `npm run db:status` (na raiz do repo).
# Testando no celular com Expo Go? Troque 127.0.0.1 pelo IP da sua máquina na rede (ex.: 192.168.0.10).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Login com Google (RNF06). Deixe "false" até configurar o provedor Google no Supabase
# (Authentication > Sign In / Providers) e liberar o redirect do app em Authentication > URL
# Configuration (ex.: exp://** e destrava://**).
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
